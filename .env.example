# Lenny Growth Assistant Configuration

# Active LLM Provider: 'ollama', 'anthropic', 'openai'
DEFAULT_PROVIDER=ollama

# Ollama Settings (Mandatory for local demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM API Keys (Optional - falls back gracefully to Ollama or local synthesis if not set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database Connection (Defaults to zero-config SQLite, can use PostgreSQL for docker)
DATABASE_URL=sqlite+aiosqlite:///./lenny.db
# DATABASE_URL=postgresql+asyncpg://lenny:lenny_secret@localhost:5432/lenny_growth_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
